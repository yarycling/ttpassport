{
  "meta": {
    "$_POST": [
      {
        "name": "session_id",
        "type": "text",
        "fieldName": "session_id",
        "options": {
          "rules": {
            "core:required": {}
          }
        }
      },
      {
        "name": "selfie_file",
        "type": "file",
        "fieldName": "selfie_file",
        "options": {
          "rules": {
            "core:required": {},
            "upload:accept": { "param": ".png,.jpg,.jpeg" },
            "upload:maxsize": { "param": "5242880" }
          }
        },
        "sub": [
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "type",
            "type": "text"
          },
          {
            "name": "size",
            "type": "number"
          },
          {
            "name": "error",
            "type": "text"
          }
        ]
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_user",
        "module": "auth",
        "action": "restrict",
        "options": {
          "provider": "ivpDemo"
        },
        "output": false
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "ivpDemo"
        },
        "output": false,
        "meta": [
          {
            "name": "identity",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "client",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "ivp",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "ivp_clients"
            },
            "primary": "client_id",
            "columns": [
              {
                "table": "ivp_clients",
                "column": "client_id"
              },
              {
                "table": "ivp_clients",
                "column": "client_key"
              },
              {
                "table": "ivp_clients",
                "column": "status"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "ivp_clients",
                  "column": "client_key",
                  "operator": "equal",
                  "operation": "=",
                  "value": "ttpassport-dev"
                },
                {
                  "table": "ivp_clients",
                  "column": "status",
                  "operator": "equal",
                  "operation": "=",
                  "value": "ACTIVE"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "client_id",
            "type": "number"
          },
          {
            "name": "client_key",
            "type": "text"
          },
          {
            "name": "status",
            "type": "text"
          }
        ],
        "outputType": "object"
      },
      {
        "name": "owned_session",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "ivp",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "ivp_sessions"
            },
            "primary": "session_id",
            "columns": [
              {
                "table": "ivp_sessions",
                "column": "session_id"
              },
              {
                "table": "ivp_sessions",
                "column": "status"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "ivp_sessions",
                  "column": "client_id",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{client.client_id}}"
                },
                {
                  "table": "ivp_sessions",
                  "column": "session_id",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{$_POST.session_id}}"
                },
                {
                  "table": "ivp_sessions",
                  "column": "created_by_user_id",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{identity}}"
                },
                {
                  "table": "ivp_sessions",
                  "column": "status",
                  "operator": "equal",
                  "operation": "=",
                  "value": "IN_PROGRESS"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "session_id",
            "type": "text"
          },
          {
            "name": "status",
            "type": "text"
          }
        ],
        "outputType": "object"
      },
      {
        "name": "authorize_selfie",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{owned_session && owned_session.session_id}}",
          "then": [
            {
              "name": "review_check",
              "module": "dbconnector",
              "action": "single",
              "options": {
                "connection": "ivp",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "ivp_checks"
                  },
                  "primary": "check_id",
                  "columns": [
                    {
                      "table": "ivp_checks",
                      "column": "check_id"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "ivp_checks",
                        "column": "client_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{client.client_id}}"
                      },
                      {
                        "table": "ivp_checks",
                        "column": "session_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{$_POST.session_id}}"
                      },
                      {
                        "table": "ivp_checks",
                        "column": "check_code",
                        "operator": "equal",
                        "operation": "=",
                        "value": "OCR_REVIEW"
                      },
                      {
                        "table": "ivp_checks",
                        "column": "status",
                        "operator": "equal",
                        "operation": "=",
                        "value": "COMPLETED"
                      }
                    ]
                  },
                  "limit": 1
                }
              },
              "output": false,
              "meta": [
                {
                  "name": "check_id",
                  "type": "number"
                }
              ],
              "outputType": "object"
            },
            {
              "name": "require_review_before_selfie",
              "module": "core",
              "action": "condition",
              "options": {
                "if": "{{review_check && review_check.check_id}}",
                "then": [
                  {
                    "name": "selfie_upload",
                    "module": "upload",
                    "action": "upload",
                    "options": {
                      "fields": "{{$_POST.selfie_file}}",
                      "path": "/storage/ivp_dev/evidence",
                      "template": "{guid}",
                      "createPath": true,
                      "throwErrors": true
                    },
                    "output": false,
                    "meta": [
                      { "name": "name", "type": "text" },
                      { "name": "path", "type": "text" },
                      { "name": "url", "type": "text" },
                      { "name": "type", "type": "text" },
                      { "name": "size", "type": "number" },
                      { "name": "error", "type": "number" }
                    ],
                    "outputType": "object"
                  },
                  {
                    "name": "accept_selfie_mime_and_size",
                    "module": "core",
                    "action": "condition",
                    "options": {
                      "if": "{{selfie_upload.size <= 5242880 && (selfie_upload.type == 'image/png' || selfie_upload.type == 'image/jpeg')}}",
                      "then": [
                        {
                          "name": "selfie_inspection",
                          "module": "ivp_ocr",
                          "action": "inspect",
                          "options": {
                            "imagePath": "{{selfie_upload.name}}"
                          },
                          "output": false,
                          "meta": [
                            {
                              "name": "valid",
                              "type": "boolean"
                            },
                            {
                              "name": "imageFormat",
                              "type": "text"
                            },
                            {
                              "name": "imageWidth",
                              "type": "number"
                            },
                            {
                              "name": "imageHeight",
                              "type": "number"
                            },
                            {
                              "name": "byteSize",
                              "type": "number"
                            },
                            {
                              "name": "sha256",
                              "type": "text"
                            },
                            {
                              "name": "errorMessage",
                              "type": "text"
                            }
                          ],
                          "outputType": "object"
                        },
                        {
                          "name": "accept_inspected_selfie",
                          "module": "core",
                          "action": "condition",
                          "options": {
                            "if": "{{selfie_inspection.valid}}",
                            "then": [
                              {
                                "name": "selfie_evidence_id",
                                "module": "crypto",
                                "action": "uuid",
                                "options": {},
                                "output": false
                              },
                              {
                                "name": "selfie_transaction",
                                "module": "dbupdater",
                                "action": "transaction",
                                "options": {
                                  "connection": "ivp",
                                  "exec": {
                                    "steps": [
                                      {
                                        "name": "save_selfie_evidence",
                                        "module": "dbupdater",
                                        "action": "insert",
                                        "options": {
                                          "connection": "ivp",
                                          "sql": {
                                            "type": "INSERT",
                                            "table": "ivp_evidence",
                                            "values": [
                                              {
                                                "column": "evidence_id",
                                                "value": "{{selfie_evidence_id}}"
                                              },
                                              {
                                                "column": "client_id",
                                                "value": "{{client.client_id}}"
                                              },
                                              {
                                                "column": "session_id",
                                                "value": "{{$_POST.session_id}}"
                                              },
                                              {
                                                "column": "owner_user_id",
                                                "value": "{{identity}}"
                                              },
                                              {
                                                "column": "evidence_type",
                                                "value": "SELFIE"
                                              },
                                              {
                                                "column": "storage_key",
                                                "value": "{{selfie_upload.name}}"
                                              },
                                              {
                                                "column": "mime_type",
                                                "value": "{{'image/' + selfie_inspection.imageFormat}}"
                                              },
                                              {
                                                "column": "byte_size",
                                                "value": "{{selfie_inspection.byteSize}}"
                                              },
                                              {
                                                "column": "sha256",
                                                "value": "{{selfie_inspection.sha256}}"
                                              }
                                            ]
                                          }
                                        },
                                        "output": false,
                                        "meta": [
                                          {
                                            "name": "identity",
                                            "type": "text"
                                          },
                                          {
                                            "name": "affected",
                                            "type": "number"
                                          }
                                        ],
                                        "outputType": "object"
                                      },
                                      {
                                        "name": "mark_selfie_captured",
                                        "module": "dbupdater",
                                        "action": "update",
                                        "options": {
                                          "connection": "ivp",
                                          "sql": {
                                            "type": "UPDATE",
                                            "table": "ivp_checks",
                                            "values": [
                                              {
                                                "column": "status",
                                                "value": "COMPLETED"
                                              },
                                              {
                                                "column": "provider_name",
                                                "value": "Wappler private evidence upload"
                                              },
                                              {
                                                "column": "model_version",
                                                "value": "local-image-inspection"
                                              }
                                            ],
                                            "wheres": {
                                              "condition": "AND",
                                              "rules": [
                                                {
                                                  "table": "ivp_checks",
                                                  "column": "client_id",
                                                  "operator": "equal",
                                                  "operation": "=",
                                                  "value": "{{client.client_id}}"
                                                },
                                                {
                                                  "table": "ivp_checks",
                                                  "column": "session_id",
                                                  "operator": "equal",
                                                  "operation": "=",
                                                  "value": "{{$_POST.session_id}}"
                                                },
                                                {
                                                  "table": "ivp_checks",
                                                  "column": "check_code",
                                                  "operator": "equal",
                                                  "operation": "=",
                                                  "value": "SELFIE_CAPTURE"
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        "output": false,
                                        "meta": [
                                          {
                                            "name": "affected",
                                            "type": "number"
                                          }
                                        ],
                                        "outputType": "object"
                                      },
                                      {
                                        "name": "mark_review_required",
                                        "module": "dbupdater",
                                        "action": "update",
                                        "options": {
                                          "connection": "ivp",
                                          "sql": {
                                            "type": "UPDATE",
                                            "table": "ivp_sessions",
                                            "values": [
                                              {
                                                "column": "status",
                                                "value": "REVIEW_REQUIRED"
                                              }
                                            ],
                                            "wheres": {
                                              "condition": "AND",
                                              "rules": [
                                                {
                                                  "table": "ivp_sessions",
                                                  "column": "client_id",
                                                  "operator": "equal",
                                                  "operation": "=",
                                                  "value": "{{client.client_id}}"
                                                },
                                                {
                                                  "table": "ivp_sessions",
                                                  "column": "session_id",
                                                  "operator": "equal",
                                                  "operation": "=",
                                                  "value": "{{$_POST.session_id}}"
                                                },
                                                {
                                                  "table": "ivp_sessions",
                                                  "column": "created_by_user_id",
                                                  "operator": "equal",
                                                  "operation": "=",
                                                  "value": "{{identity}}"
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        "output": false,
                                        "meta": [
                                          {
                                            "name": "affected",
                                            "type": "number"
                                          }
                                        ],
                                        "outputType": "object"
                                      }
                                    ]
                                  }
                                },
                                "output": false
                              },
                              {
                                "name": "selfie_result",
                                "module": "core",
                                "action": "setvalue",
                                "options": {
                                  "value": {
                                    "accepted": true,
                                    "session_status": "REVIEW_REQUIRED",
                                    "face_comparison": "NOT_PERFORMED",
                                    "liveness": "NOT_PERFORMED"
                                  }
                                },
                                "output": true,
                                "meta": [
                                  {
                                    "name": "accepted",
                                    "type": "boolean"
                                  },
                                  {
                                    "name": "session_status",
                                    "type": "text"
                                  },
                                  {
                                    "name": "face_comparison",
                                    "type": "text"
                                  },
                                  {
                                    "name": "liveness",
                                    "type": "text"
                                  }
                                ],
                                "outputType": "object"
                              }
                            ],
                            "else": [
                              {
                                "name": "remove_rejected_file",
                                "module": "fs",
                                "action": "remove",
                                "options": {
                                  "path": "{{'/storage/ivp_dev/evidence/' + selfie_upload.name}}"
                                },
                                "output": false
                              },
                              {
                                "name": "reject_invalid_upload",
                                "module": "core",
                                "action": "response",
                                "options": {
                                  "status": 400,
                                  "data": {
                                    "message": "Choose a valid JPEG or PNG image no larger than 5 MB and at least 320 × 200 pixels."
                                  }
                                },
                                "output": false
                              }
                            ]
                          },
                          "output": false
                        }
                      ],
                      "else": [
                        {
                          "name": "remove_rejected_file",
                          "module": "fs",
                          "action": "remove",
                          "options": {
                            "path": "{{'/storage/ivp_dev/evidence/' + selfie_upload.name}}"
                          },
                          "output": false
                        },
                        {
                          "name": "reject_invalid_upload",
                          "module": "core",
                          "action": "response",
                          "options": {
                            "status": 400,
                            "data": {
                              "message": "Choose a valid JPEG or PNG image no larger than 5 MB and at least 320 × 200 pixels."
                            }
                          },
                          "output": false
                        }
                      ]
                    },
                    "output": false
                  }
                ],
                "else": [
                  {
                    "name": "reject_unreviewed_selfie",
                    "module": "core",
                    "action": "response",
                    "options": {
                      "status": 400,
                      "data": {
                        "message": "Review the extracted values before capturing selfie evidence."
                      }
                    },
                    "output": false
                  }
                ]
              },
              "output": false
            }
          ],
          "else": [
            {
              "name": "reject_unknown_session",
              "module": "core",
              "action": "response",
              "options": {
                "status": 404,
                "data": {
                  "message": "Session not found or unavailable."
                }
              },
              "output": false
            }
          ]
        },
        "output": false
      }
    ]
  }
}
