                          "type": "text"
                        },
                        {
                          "name": "affected",
                          "type": "number"
                        }
                      ],
                      "outputType": "object"
                    },
                    {
                      "name": "use_new_subject",
                      "module": "core",
                      "action": "setvalue",
                      "options": {
                        "key": "subjectId",
                        "value": "{{new_subject_id}}"
                      },
                      "output": false,
                      "outputType": "text"
                    }
                  ]
