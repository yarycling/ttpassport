                  "if": "{{subject && subject.subject_id}}",
                  "then": [
                    {
                      "name": "use_existing_subject",
                      "module": "core",
                      "action": "setvalue",
                      "options": {
                        "key": "subjectId",
                        "value": "{{subject.subject_id}}"
                      },
                      "output": false,
                      "outputType": "text"
                    }
                  ],
                  "else": [
                    {
                      "name": "new_subject_id",
                      "module": "crypto",
                      "action": "uuid",
                      "options": {},
                      "output": false
                    },
                    {
                      "name": "insert_subject",
                      "module": "dbupdater",
                      "action": "insert",
                      "options": {
                        "connection": "ivp",
                        "sql": {
                          "type": "INSERT",
                          "table": "ivp_subjects",
                          "values": [
                            {
                              "column": "subject_id",
                              "value": "{{new_subject_id}}"
                            },
                            {
                              "column": "client_id",
                              "value": "{{client.client_id}}"
                            },
                            {
                              "column": "owner_user_id",
                              "value": "{{identity}}"
                            }
                          ]
                        }
                      },
                      "output": false,
                      "meta": [
                        {
