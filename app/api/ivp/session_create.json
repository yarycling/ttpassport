          }
        ],
        "outputType": "array"
      },
      {
        "name": "seed_client_if_missing",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{clients.count() == 0}}",
          "then": [
            {
              "name": "seed_development_client",
              "module": "dbupdater",
              "action": "insert",
              "options": {
                "connection": "ivp",
                "sql": {
                  "type": "INSERT",
                  "table": "ivp_clients",
                  "values": [
                    {
                      "column": "client_key",
                      "value": "ttpassport-dev"
                    },
                    {
                      "column": "display_name",
                      "value": "TTPASSPORT Development"
                    },
                    {
                      "column": "status",
                      "value": "ACTIVE"
                    }
                  ]
                }
              },
              "output": false,
              "meta": [
                {
                  "name": "identity",
                  "type": "text"
                },
                {
                  "name": "affected",
                  "type": "number"
                }
