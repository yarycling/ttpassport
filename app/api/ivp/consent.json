{
  "meta": {
    "$_POST": [
      {
        "name": "session_id",
        "type": "text",
        "fieldName": "session_id",
        "options": {
          "rules": {
            "core:required": {}
          }
        }
      },
      {
        "name": "consent_accepted",
        "type": "number",
        "fieldName": "consent_accepted",
        "options": {
          "rules": {
            "core:required": {}
          }
        }
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "citizen_identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "citizen"
        },
        "output": false,
        "meta": [
          {
            "name": "citizen_identity",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "authorize_authenticated_provider",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{citizen_identity}}",
          "then": [
            {
              "name": "restrict_citizen",
              "module": "auth",
              "action": "restrict",
              "options": {
                "provider": "citizen"
              },
              "output": false
            }
          ],
          "else": [
            {
              "name": "restrict_ivp_demo",
              "module": "auth",
              "action": "restrict",
              "options": {
                "provider": "ivpDemo"
              },
              "output": false
            }
          ]
        },
        "output": false
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "ivpDemo"
        },
        "output": false,
        "meta": [
          {
            "name": "identity",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "current_application",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "passport",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "passport_applications"
            },
            "primary": "id",
            "columns": [
              {
                "table": "passport_applications",
                "column": "application_key"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "passport_applications",
                  "column": "account_id",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{citizen_identity}}"
                },
                {
                  "table": "passport_applications",
                  "column": "application_type",
                  "operator": "equal",
                  "operation": "=",
                  "value": "FIRST_TIME"
                },
                {
                  "table": "passport_applications",
                  "column": "status",
                  "operator": "equal",
                  "operation": "=",
                  "value": "DRAFT"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "application_key",
            "type": "text"
          }
        ],
        "outputType": "object"
      },
      {
        "name": "client_subject_ref",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "client_subject_ref",
          "value": "{{citizen_identity ? (current_application.application_key || null) : null}}"
        },
        "output": false,
        "meta": [
          {
            "name": "client_subject_ref",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "require_owned_draft_for_citizen",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{citizen_identity && !current_application.application_key}}",
          "then": [
            {
              "name": "draft_not_found",
              "module": "core",
              "action": "response",
              "options": {
                "status": 404,
                "data": {
                  "message": "A saved first-time draft is required before verification can continue."
                }
              },
              "output": false
            }
          ],
          "else": []
        },
        "output": false
      },
      {
        "name": "client",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "ivp",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "ivp_clients"
            },
            "primary": "client_id",
            "columns": [
              {
                "table": "ivp_clients",
                "column": "client_id"
              },
              {
                "table": "ivp_clients",
                "column": "client_key"
              },
              {
                "table": "ivp_clients",
                "column": "status"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "ivp_clients",
                  "column": "client_key",
                  "operator": "equal",
                  "operation": "=",
                  "value": "ttpassport-dev"
                },
                {
                  "table": "ivp_clients",
                  "column": "status",
                  "operator": "equal",
                  "operation": "=",
                  "value": "ACTIVE"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "client_id",
            "type": "number"
          },
          {
            "name": "client_key",
            "type": "text"
          },
          {
            "name": "status",
            "type": "text"
          }
        ],
        "outputType": "object"
      },
      {
        "name": "require_explicit_consent",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_POST.consent_accepted == 1}}",
          "then": [
            {
              "name": "resolve_owned_session",
              "module": "core",
              "action": "condition",
              "options": {
                "if": "{{citizen_identity}}",
                "then": [
                  {
                    "name": "citizen_owned_session",
                    "module": "dbconnector",
                    "action": "single",
                    "options": {
                      "connection": "ivp",
                      "sql": {
                        "type": "SELECT",
                        "table": {
                          "name": "ivp_sessions"
                        },
                        "primary": "session_id",
                        "columns": [
                          {
                            "table": "ivp_sessions",
                            "column": "session_id"
                          },
                          {
                            "table": "ivp_sessions",
                            "column": "status"
                          }
                        ],
                        "wheres": {
                          "condition": "AND",
                          "rules": [
                            {
                              "table": "ivp_sessions",
                              "column": "client_id",
                              "operator": "equal",
                              "operation": "=",
                              "value": "{{client.client_id}}"
                            },
                            {
                              "table": "ivp_sessions",
                              "column": "session_id",
                              "operator": "equal",
                              "operation": "=",
                              "value": "{{$_POST.session_id}}"
                            },
                            {
                              "table": "ivp_sessions",
                              "column": "created_by_client_subject_ref",
                              "operator": "equal",
                              "operation": "=",
                              "value": "{{current_application.application_key}}"
                            },
                            {
                              "table": "ivp_sessions",
                              "column": "status",
                              "operator": "equal",
                              "operation": "=",
                              "value": "CONSENT_REQUIRED"
                            }
                          ]
                        },
                        "limit": 1
                      }
                    },
                    "output": false,
                    "meta": [
                      {
                        "name": "session_id",
                        "type": "text"
                      },
                      {
                        "name": "status",
                        "type": "text"
                      }
                    ],
                    "outputType": "object"
                  },
                  {
                    "name": "owned_session",
                    "module": "core",
                    "action": "setvalue",
                    "options": {
                      "key": "owned_session",
                      "value": "{{citizen_owned_session}}"
                    },
                    "output": true,
                    "meta": [
                      {
                        "name": "session_id",
                        "type": "text"
                      },
                      {
                        "name": "status",
                        "type": "text"
                      }
                    ],
                    "outputType": "object"
                  }
                ],
                "else": [
                  {
                    "name": "demo_owned_session",
                    "module": "dbconnector",
                    "action": "single",
                    "options": {
                      "connection": "ivp",
                      "sql": {
                        "type": "SELECT",
                        "table": {
                          "name": "ivp_sessions"
                        },
                        "primary": "session_id",
                        "columns": [
                          {
                            "table": "ivp_sessions",
                            "column": "session_id"
                          },
                          {
                            "table": "ivp_sessions",
                            "column": "status"
                          }
                        ],
                        "wheres": {
                          "condition": "AND",
                          "rules": [
                            {
                              "table": "ivp_sessions",
                              "column": "client_id",
                              "operator": "equal",
                              "operation": "=",
                              "value": "{{client.client_id}}"
                            },
                            {
                              "table": "ivp_sessions",
                              "column": "session_id",
                              "operator": "equal",
                              "operation": "=",
                              "value": "{{$_POST.session_id}}"
                            },
                            {
                              "table": "ivp_sessions",
                              "column": "created_by_user_id",
                              "operator": "equal",
                              "operation": "=",
                              "value": "{{identity}}"
                            },
                            {
                              "table": "ivp_sessions",
                              "column": "status",
                              "operator": "equal",
                              "operation": "=",
                              "value": "CONSENT_REQUIRED"
                            }
                          ]
                        },
                        "limit": 1
                      }
                    },
                    "output": false,
                    "meta": [
                      {
                        "name": "session_id",
                        "type": "text"
                      },
                      {
                        "name": "status",
                        "type": "text"
                      }
                    ],
                    "outputType": "object"
                  },
                  {
                    "name": "owned_session",
                    "module": "core",
                    "action": "setvalue",
                    "options": {
                      "key": "owned_session",
                      "value": "{{demo_owned_session}}"
                    },
                    "output": true,
                    "meta": [
                      {
                        "name": "session_id",
                        "type": "text"
                      },
                      {
                        "name": "status",
                        "type": "text"
                      }
                    ],
                    "outputType": "object"
                  }
                ]
              },
              "output": false
            },
            {
              "name": "authorize_consent",
              "module": "core",
              "action": "condition",
              "options": {
                "if": "{{owned_session && owned_session.session_id}}",
                "then": [
                  {
                    "name": "consent_transaction",
                    "module": "dbupdater",
                    "action": "transaction",
                    "options": {
                      "connection": "ivp",
                      "exec": {
                        "steps": [
                          {
                            "name": "consent_id",
                            "module": "crypto",
                            "action": "uuid",
                            "options": {},
                            "output": false
                          },
                          {
                            "name": "record_consent",
                            "module": "dbupdater",
                            "action": "insert",
                            "options": {
                              "connection": "ivp",
                              "sql": {
                                "type": "INSERT",
                                "table": "ivp_consents",
                                "values": [
                                  {
                                    "column": "consent_id",
                                    "value": "{{consent_id}}"
                                  },
                                  {
                                    "column": "client_id",
                                    "value": "{{client.client_id}}"
                                  },
                                  {
                                    "column": "session_id",
                                    "value": "{{$_POST.session_id}}"
                                  },
                                  {
                                    "column": "actor_user_id",
                                    "value": "{{citizen_identity ? null : identity}}"
                                  },
                                  {
                                    "column": "actor_client_subject_ref",
                                    "value": "{{citizen_identity ? current_application.application_key : null}}"
                                  },
                                  {
                                    "column": "consent_version",
                                    "value": "TTP-DEV-CONSENT-1.2-LIVENESS"
                                  },
                                  {
                                    "column": "accepted",
                                    "value": 1
                                  }
                                ]
                              }
                            },
                            "output": false,
                            "meta": [
                              {
                                "name": "identity",
                                "type": "text"
                              },
                              {
                                "name": "affected",
                                "type": "number"
                              }
                            ],
                            "outputType": "object"
                          },
                          {
                            "name": "mark_session_in_progress",
                            "module": "dbupdater",
                            "action": "update",
                            "options": {
                              "connection": "ivp",
                              "sql": {
                                "type": "UPDATE",
                                "table": "ivp_sessions",
                                "values": [
                                  {
                                    "column": "status",
                                    "value": "IN_PROGRESS"
                                  }
                                ],
                                "wheres": {
                                  "condition": "AND",
                                  "rules": [
                                    {
                                      "table": "ivp_sessions",
                                      "column": "client_id",
                                      "operator": "equal",
                                      "operation": "=",
                                      "value": "{{client.client_id}}"
                                    },
                                    {
                                      "table": "ivp_sessions",
                                      "column": "session_id",
                                      "operator": "equal",
                                      "operation": "=",
                                      "value": "{{$_POST.session_id}}"
                                    }
                                  ]
                                }
                              }
                            },
                            "output": false,
                            "meta": [
                              {
                                "name": "affected",
                                "type": "number"
                              }
                            ],
                            "outputType": "object"
                          }
                        ]
                      }
                    },
                    "output": false
                  },
                  {
                    "name": "consent_result",
                    "module": "core",
                    "action": "setvalue",
                    "options": {
                      "key": "consentResult",
                      "value": "CONSENT_RECORDED"
                    },
                    "output": true,
                    "outputType": "text"
                  }
                ],
                "else": [
                  {
                    "name": "consent_unavailable",
                    "module": "core",
                    "action": "response",
                    "options": {
                      "status": 404,
                      "data": {
                        "message": "This session is unavailable."
                      }
                    },
                    "output": false
                  }
                ]
              },
              "output": false
            }
          ],
          "else": [
            {
              "name": "consent_required",
              "module": "core",
              "action": "response",
              "options": {
                "status": 400,
                "data": {
                  "message": "Accept the development consent to continue."
                }
              },
              "output": false
            }
          ]
        },
        "output": false
      }
    ]
  }
}
