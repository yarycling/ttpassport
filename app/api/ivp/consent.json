{
  "meta": {
    "$_POST": [
      {
        "name": "session_id",
        "type": "text",
        "fieldName": "session_id",
        "options": {
          "rules": {
            "core:required": {}
          }
        }
      },
      {
        "name": "consent_accepted",
        "type": "number",
        "fieldName": "consent_accepted",
        "options": {
          "rules": {
            "core:required": {}
          }
        }
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_user",
        "module": "auth",
        "action": "restrict",
        "options": {
          "provider": "ivpDemo"
        },
        "output": false
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "ivpDemo"
        },
        "output": false,
        "meta": [
          {
            "name": "identity",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "client",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "ivp",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "ivp_clients"
            },
            "primary": "client_id",
            "columns": [
              {
                "table": "ivp_clients",
                "column": "client_id"
              },
              {
                "table": "ivp_clients",
                "column": "client_key"
              },
              {
                "table": "ivp_clients",
                "column": "status"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "ivp_clients",
                  "column": "client_key",
                  "operator": "equal",
                  "operation": "=",
                  "value": "ttpassport-dev"
                },
                {
                  "table": "ivp_clients",
                  "column": "status",
                  "operator": "equal",
                  "operation": "=",
                  "value": "ACTIVE"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "client_id",
            "type": "number"
          },
          {
            "name": "client_key",
            "type": "text"
          },
          {
            "name": "status",
            "type": "text"
          }
        ],
        "outputType": "object"
      },
      {
        "name": "require_explicit_consent",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_POST.consent_accepted == 1}}",
          "then": [
            {
              "name": "owned_session",
              "module": "dbconnector",
              "action": "single",
              "options": {
                "connection": "ivp",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "ivp_sessions"
                  },
                  "primary": "session_id",
                  "columns": [
                    {
                      "table": "ivp_sessions",
                      "column": "session_id"
                    },
                    {
                      "table": "ivp_sessions",
                      "column": "status"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "ivp_sessions",
                        "column": "client_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{client.client_id}}"
                      },
                      {
                        "table": "ivp_sessions",
                        "column": "session_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{$_POST.session_id}}"
                      },
                      {
                        "table": "ivp_sessions",
                        "column": "created_by_user_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{identity}}"
                      },
                      {
                        "table": "ivp_sessions",
                        "column": "status",
                        "operator": "equal",
                        "operation": "=",
                        "value": "CONSENT_REQUIRED"
                      }
                    ]
                  },
                  "limit": 1
                }
              },
              "output": false,
              "meta": [
                {
                  "name": "session_id",
                  "type": "text"
                },
                {
                  "name": "status",
                  "type": "text"
                }
              ],
              "outputType": "object"
            },
            {
              "name": "authorize_consent",
              "module": "core",
              "action": "condition",
              "options": {
                "if": "{{owned_session && owned_session.session_id}}",
                "then": [
                  {
                    "name": "consent_transaction",
                    "module": "dbupdater",
                    "action": "transaction",
                    "options": {
                      "connection": "ivp",
                      "exec": {
                        "steps": [
                          {
                            "name": "consent_id",
                            "module": "crypto",
                            "action": "uuid",
                            "options": {},
                            "output": false
                          },
                          {
                            "name": "record_consent",
                            "module": "dbupdater",
                            "action": "insert",
                            "options": {
                              "connection": "ivp",
                              "sql": {
                                "type": "INSERT",
                                "table": "ivp_consents",
                                "values": [
                                  {
                                    "column": "consent_id",
                                    "value": "{{consent_id}}"
                                  },
                                  {
                                    "column": "client_id",
                                    "value": "{{client.client_id}}"
                                  },
                                  {
                                    "column": "session_id",
                                    "value": "{{$_POST.session_id}}"
                                  },
                                  {
                                    "column": "actor_user_id",
                                    "value": "{{identity}}"
                                  },
                                  {
                                    "column": "consent_version",
                                    "value": "TTP-DEV-CONSENT-1.1-FACE-POC"
                                  },
                                  {
                                    "column": "accepted",
                                    "value": 1
                                  }
                                ]
                              }
                            },
                            "output": false,
                            "meta": [
                              {
                                "name": "identity",
                                "type": "text"
                              },
                              {
                                "name": "affected",
                                "type": "number"
                              }
                            ],
                            "outputType": "object"
                          },
                          {
                            "name": "mark_session_in_progress",
                            "module": "dbupdater",
                            "action": "update",
                            "options": {
                              "connection": "ivp",
                              "sql": {
                                "type": "UPDATE",
                                "table": "ivp_sessions",
                                "values": [
                                  {
                                    "column": "status",
                                    "value": "IN_PROGRESS"
                                  }
                                ],
                                "wheres": {
                                  "condition": "AND",
                                  "rules": [
                                    {
                                      "table": "ivp_sessions",
                                      "column": "client_id",
                                      "operator": "equal",
                                      "operation": "=",
                                      "value": "{{client.client_id}}"
                                    },
                                    {
                                      "table": "ivp_sessions",
                                      "column": "session_id",
                                      "operator": "equal",
                                      "operation": "=",
                                      "value": "{{$_POST.session_id}}"
                                    },
                                    {
                                      "table": "ivp_sessions",
                                      "column": "created_by_user_id",
                                      "operator": "equal",
                                      "operation": "=",
                                      "value": "{{identity}}"
                                    }
                                  ]
                                }
                              }
                            },
                            "output": false,
                            "meta": [
                              {
                                "name": "affected",
                                "type": "number"
                              }
                            ],
                            "outputType": "object"
                          }
                        ]
                      }
                    },
                    "output": false
                  },
                  {
                    "name": "consent_result",
                    "module": "core",
                    "action": "setvalue",
                    "options": {
                      "key": "consentResult",
                      "value": "CONSENT_RECORDED"
                    },
                    "output": true,
                    "outputType": "text"
                  }
                ],
                "else": [
                  {
                    "name": "consent_unavailable",
                    "module": "core",
                    "action": "error",
                    "options": {
                      "message": "This session is unavailable.",
                      "fieldName": "form"
                    },
                    "output": false
                  }
                ]
              },
              "output": false
            }
          ],
          "else": [
            {
              "name": "consent_required",
              "module": "core",
              "action": "response",
              "options": {
                "status": 400,
                "data": { "message": "Accept the development consent to continue." }
              },
              "output": false
            }
          ]
        },
        "output": false
      }
    ]
  }
}
