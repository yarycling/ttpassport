{
  "meta": {},
  "exec": {
    "steps": [
      {
        "name": "citizen_identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "citizen"
        },
        "output": false,
        "meta": [
          {
            "name": "citizen_identity",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "authorize_authenticated_provider",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{citizen_identity}}",
          "then": [
            {
              "name": "restrict_citizen",
              "module": "auth",
              "action": "restrict",
              "options": {
                "provider": "citizen"
              },
              "output": false
            }
          ],
          "else": [
            {
              "name": "restrict_ivp_demo",
              "module": "auth",
              "action": "restrict",
              "options": {
                "provider": "ivpDemo"
              },
              "output": false
            }
          ]
        },
        "output": false
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "ivpDemo"
        },
        "output": false,
        "meta": [
          {
            "name": "identity",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "current_application",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "passport",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "passport_applications"
            },
            "primary": "id",
            "columns": [
              {
                "table": "passport_applications",
                "column": "application_key"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "passport_applications",
                  "column": "account_id",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{citizen_identity}}"
                },
                {
                  "table": "passport_applications",
                  "column": "application_type",
                  "operator": "equal",
                  "operation": "=",
                  "value": "FIRST_TIME"
                },
                {
                  "table": "passport_applications",
                  "column": "status",
                  "operator": "equal",
                  "operation": "=",
                  "value": "DRAFT"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "application_key",
            "type": "text"
          }
        ],
        "outputType": "object"
      },
      {
        "name": "client_subject_ref",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "client_subject_ref",
          "value": "{{citizen_identity ? (current_application.application_key || null) : null}}"
        },
        "output": false,
        "meta": [
          {
            "name": "client_subject_ref",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "require_owned_draft_for_citizen",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{citizen_identity && !current_application.application_key}}",
          "then": [
            {
              "name": "draft_not_found",
              "module": "core",
              "action": "response",
              "options": {
                "status": 404,
                "data": {
                  "message": "A saved first-time draft is required before verification can continue."
                }
              },
              "output": false
            }
          ],
          "else": []
        },
        "output": false
      },
      {
        "name": "client",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "ivp",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "ivp_clients"
            },
            "primary": "client_id",
            "columns": [
              {
                "table": "ivp_clients",
                "column": "client_id"
              },
              {
                "table": "ivp_clients",
                "column": "client_key"
              },
              {
                "table": "ivp_clients",
                "column": "status"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "ivp_clients",
                  "column": "client_key",
                  "operator": "equal",
                  "operation": "=",
                  "value": "ttpassport-dev"
                },
                {
                  "table": "ivp_clients",
                  "column": "status",
                  "operator": "equal",
                  "operation": "=",
                  "value": "ACTIVE"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "client_id",
            "type": "number"
          },
          {
            "name": "client_key",
            "type": "text"
          },
          {
            "name": "status",
            "type": "text"
          }
        ],
        "outputType": "object"
      },
      {
        "name": "resolve_owned_session",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{citizen_identity}}",
          "then": [
            {
              "name": "citizen_session",
              "module": "dbconnector",
              "action": "single",
              "options": {
                "connection": "ivp",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "ivp_sessions"
                  },
                  "primary": "session_id",
                  "columns": [
                    {
                      "table": "ivp_sessions",
                      "column": "session_id"
                    },
                    {
                      "table": "ivp_sessions",
                      "column": "status"
                    },
                    {
                      "table": "ivp_sessions",
                      "column": "policy_version"
                    },
                    {
                      "table": "ivp_sessions",
                      "column": "created_at"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "ivp_sessions",
                        "column": "client_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{client.client_id}}"
                      },
                      {
                        "table": "ivp_sessions",
                        "column": "created_by_client_subject_ref",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{current_application.application_key}}"
                      }
                    ]
                  },
                  "orders": [
                    {
                      "table": "ivp_sessions",
                      "column": "created_at",
                      "direction": "DESC"
                    }
                  ],
                  "limit": 1
                }
              },
              "output": true,
              "meta": [
                {
                  "name": "session_id",
                  "type": "text"
                },
                {
                  "name": "status",
                  "type": "text"
                },
                {
                  "name": "policy_version",
                  "type": "text"
                },
                {
                  "name": "created_at",
                  "type": "text"
                }
              ],
              "outputType": "object"
            },
            {
              "name": "session",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "session",
                "value": "{{citizen_session}}"
              },
              "output": true,
              "meta": [
                {
                  "name": "session",
                  "type": "object"
                }
              ],
              "outputType": "object"
            }
          ],
          "else": [
            {
              "name": "demo_session",
              "module": "dbconnector",
              "action": "single",
              "options": {
                "connection": "ivp",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "ivp_sessions"
                  },
                  "primary": "session_id",
                  "columns": [
                    {
                      "table": "ivp_sessions",
                      "column": "session_id"
                    },
                    {
                      "table": "ivp_sessions",
                      "column": "status"
                    },
                    {
                      "table": "ivp_sessions",
                      "column": "policy_version"
                    },
                    {
                      "table": "ivp_sessions",
                      "column": "created_at"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "ivp_sessions",
                        "column": "client_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{client.client_id}}"
                      },
                      {
                        "table": "ivp_sessions",
                        "column": "created_by_user_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{identity}}"
                      }
                    ]
                  },
                  "orders": [
                    {
                      "table": "ivp_sessions",
                      "column": "created_at",
                      "direction": "DESC"
                    }
                  ],
                  "limit": 1
                }
              },
              "output": true,
              "meta": [
                {
                  "name": "session_id",
                  "type": "text"
                },
                {
                  "name": "status",
                  "type": "text"
                },
                {
                  "name": "policy_version",
                  "type": "text"
                },
                {
                  "name": "created_at",
                  "type": "text"
                }
              ],
              "outputType": "object"
            },
            {
              "name": "session",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "session",
                "value": "{{demo_session}}"
              },
              "output": true,
              "meta": [
                {
                  "name": "session",
                  "type": "object"
                }
              ],
              "outputType": "object"
            }
          ]
        },
        "output": false
      },
      {
        "name": "load_owned_session_details",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{session && session.session_id}}",
          "then": [
            {
              "name": "checks",
              "module": "dbconnector",
              "action": "select",
              "options": {
                "connection": "ivp",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "ivp_checks"
                  },
                  "primary": "check_code",
                  "columns": [
                    {
                      "table": "ivp_checks",
                      "column": "check_code"
                    },
                    {
                      "table": "ivp_checks",
                      "column": "status"
                    },
                    {
                      "table": "ivp_checks",
                      "column": "provider_name"
                    },
                    {
                      "table": "ivp_checks",
                      "column": "model_version"
                    },
                    {
                      "table": "ivp_checks",
                      "column": "created_at"
                    },
                    {
                      "table": "ivp_checks",
                      "column": "details_json"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "ivp_checks",
                        "column": "client_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{client.client_id}}"
                      },
                      {
                        "table": "ivp_checks",
                        "column": "session_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{session.session_id}}"
                      }
                    ]
                  },
                  "orders": [
                    {
                      "table": "ivp_checks",
                      "column": "check_id",
                      "direction": "ASC"
                    }
                  ]
                }
              },
              "output": true,
              "meta": [
                {
                  "name": "check_code",
                  "type": "text"
                },
                {
                  "name": "status",
                  "type": "text"
                },
                {
                  "name": "provider_name",
                  "type": "text"
                },
                {
                  "name": "model_version",
                  "type": "text"
                },
                {
                  "name": "created_at",
                  "type": "text"
                },
                {
                  "name": "details_json",
                  "type": "object"
                }
              ],
              "outputType": "array"
            },
            {
              "name": "ocr_results",
              "module": "dbconnector",
              "action": "select",
              "options": {
                "connection": "ivp",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "ivp_ocr_results"
                  },
                  "primary": "ocr_result_id",
                  "columns": [
                    {
                      "table": "ivp_ocr_results",
                      "column": "ocr_result_id"
                    },
                    {
                      "table": "ivp_ocr_results",
                      "column": "original_text"
                    },
                    {
                      "table": "ivp_ocr_results",
                      "column": "extracted_fields"
                    },
                    {
                      "table": "ivp_ocr_results",
                      "column": "corrected_fields"
                    },
                    {
                      "table": "ivp_ocr_results",
                      "column": "confidence"
                    },
                    {
                      "table": "ivp_ocr_results",
                      "column": "engine_version"
                    },
                    {
                      "table": "ivp_ocr_results",
                      "column": "model_revision"
                    },
                    {
                      "table": "ivp_ocr_results",
                      "column": "reviewed_at"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "ivp_ocr_results",
                        "column": "client_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{client.client_id}}"
                      },
                      {
                        "table": "ivp_ocr_results",
                        "column": "session_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{session.session_id}}"
                      }
                    ]
                  },
                  "orders": [
                    {
                      "table": "ivp_ocr_results",
                      "column": "created_at",
                      "direction": "DESC"
                    }
                  ],
                  "limit": 10
                }
              },
              "output": true,
              "meta": [
                {
                  "name": "ocr_result_id",
                  "type": "number"
                },
                {
                  "name": "original_text",
                  "type": "text"
                },
                {
                  "name": "extracted_fields",
                  "type": "object"
                },
                {
                  "name": "corrected_fields",
                  "type": "object"
                },
                {
                  "name": "confidence",
                  "type": "number"
                },
                {
                  "name": "engine_version",
                  "type": "text"
                },
                {
                  "name": "model_revision",
                  "type": "text"
                },
                {
                  "name": "reviewed_at",
                  "type": "text"
                }
              ],
              "outputType": "array"
            },
            {
              "name": "evidence",
              "module": "dbconnector",
              "action": "select",
              "options": {
                "connection": "ivp",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "ivp_evidence"
                  },
                  "primary": "evidence_id",
                  "columns": [
                    {
                      "table": "ivp_evidence",
                      "column": "evidence_id"
                    },
                    {
                      "table": "ivp_evidence",
                      "column": "evidence_type"
                    },
                    {
                      "table": "ivp_evidence",
                      "column": "mime_type"
                    },
                    {
                      "table": "ivp_evidence",
                      "column": "byte_size"
                    },
                    {
                      "table": "ivp_evidence",
                      "column": "created_at"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "ivp_evidence",
                        "column": "client_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{client.client_id}}"
                      },
                      {
                        "table": "ivp_evidence",
                        "column": "session_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{session.session_id}}"
                      }
                    ]
                  },
                  "orders": [
                    {
                      "table": "ivp_evidence",
                      "column": "created_at",
                      "direction": "DESC"
                    }
                  ],
                  "limit": 10
                }
              },
              "output": true,
              "meta": [
                {
                  "name": "evidence_id",
                  "type": "text"
                },
                {
                  "name": "evidence_type",
                  "type": "text"
                },
                {
                  "name": "mime_type",
                  "type": "text"
                },
                {
                  "name": "byte_size",
                  "type": "number"
                },
                {
                  "name": "created_at",
                  "type": "text"
                }
              ],
              "outputType": "array"
            },
            {
              "name": "liveness_consent",
              "module": "dbconnector",
              "action": "single",
              "options": {
                "connection": "ivp",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "ivp_consents"
                  },
                  "primary": "consent_id",
                  "columns": [
                    {
                      "table": "ivp_consents",
                      "column": "consent_id"
                    },
                    {
                      "table": "ivp_consents",
                      "column": "consent_version"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "ivp_consents",
                        "column": "client_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{client.client_id}}"
                      },
                      {
                        "table": "ivp_consents",
                        "column": "session_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{session.session_id}}"
                      },
                      {
                        "table": "ivp_consents",
                        "column": "consent_version",
                        "operator": "equal",
                        "operation": "=",
                        "value": "TTP-DEV-CONSENT-1.2-LIVENESS"
                      },
                      {
                        "table": "ivp_consents",
                        "column": "accepted",
                        "operator": "equal",
                        "operation": "=",
                        "value": 1
                      }
                    ]
                  },
                  "orders": [
                    {
                      "table": "ivp_consents",
                      "column": "captured_at",
                      "direction": "DESC"
                    }
                  ],
                  "limit": 1
                }
              },
              "output": true,
              "meta": [
                {
                  "name": "consent_id",
                  "type": "text"
                },
                {
                  "name": "consent_version",
                  "type": "text"
                }
              ],
              "outputType": "object"
            }
          ],
          "else": [
            {
              "name": "empty_checks",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "checks",
                "value": []
              },
              "output": true,
              "outputType": "array"
            },
            {
              "name": "empty_ocr_results",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "ocr_results",
                "value": []
              },
              "output": true,
              "outputType": "array"
            },
            {
              "name": "empty_evidence",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "evidence",
                "value": []
              },
              "output": true,
              "outputType": "array"
            },
            {
              "name": "empty_liveness_consent",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "liveness_consent",
                "value": null
              },
              "output": true,
              "outputType": "object"
            }
          ]
        },
        "output": false
      }
    ]
  }
}
