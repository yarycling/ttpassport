{
  "meta": {
    "$_GET": [
      {
        "name": "application_key",
        "type": "text",
        "fieldName": "application_key",
        "options": {
          "rules": {
            "core:required": {}
          }
        }
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_citizen",
        "module": "auth",
        "action": "restrict",
        "options": {
          "provider": "citizen"
        },
        "output": false
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "citizen"
        },
        "output": false,
        "meta": [
          {
            "name": "identity",
            "type": "number"
          }
        ],
        "outputType": "number"
      },
      {
        "name": "owned_application",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "passport",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "passport_applications"
            },
            "primary": "id",
            "columns": [
              {
                "table": "passport_applications",
                "column": "id"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "passport_applications",
                  "column": "application_key",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{$_GET.application_key}}"
                },
                {
                  "table": "passport_applications",
                  "column": "account_id",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{identity}}"
                },
                {
                  "table": "passport_applications",
                  "column": "application_type",
                  "operator": "equal",
                  "operation": "=",
                  "value": "FIRST_TIME"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "id",
            "type": "number"
          }
        ],
        "outputType": "array"
      },
      {
        "name": "load_current_photo_if_owned",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{owned_application.count() == 1}}",
          "then": [
            {
              "name": "photo",
              "module": "dbconnector",
              "action": "select",
              "options": {
                "connection": "passport",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "passport_application_evidence"
                  },
                  "primary": "id",
                  "columns": [
                    {
                      "table": "passport_application_evidence",
                      "column": "evidence_key"
                    },
                    {
                      "table": "passport_application_evidence",
                      "column": "original_filename"
                    },
                    {
                      "table": "passport_application_evidence",
                      "column": "mime_type"
                    },
                    {
                      "table": "passport_application_evidence",
                      "column": "byte_size"
                    },
                    {
                      "table": "passport_application_evidence",
                      "column": "version_number"
                    },
                    {
                      "table": "passport_application_evidence",
                      "column": "evidence_status"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "passport_application_evidence",
                        "column": "application_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{owned_application[0].id}}"
                      },
                      {
                        "table": "passport_application_evidence",
                        "column": "evidence_kind",
                        "operator": "equal",
                        "operation": "=",
                        "value": "PASSPORT_PHOTOGRAPH"
                      },
                      {
                        "table": "passport_application_evidence",
                        "column": "evidence_status",
                        "operator": "equal",
                        "operation": "=",
                        "value": "ACTIVE"
                      }
                    ]
                  },
                  "limit": 1
                }
              },
              "output": true,
              "meta": [
                { "name": "evidence_key", "type": "text" },
                { "name": "original_filename", "type": "text" },
                { "name": "mime_type", "type": "text" },
                { "name": "byte_size", "type": "number" },
                { "name": "version_number", "type": "number" },
                { "name": "evidence_status", "type": "text" }
              ],
              "outputType": "array"
            }
          ],
          "else": [
            {
              "name": "application_not_found",
              "module": "core",
              "action": "response",
              "options": {
                "status": 404,
                "data": {
                  "message": "The saved application was not found."
                }
              },
              "output": false
            }
          ]
        },
        "output": false
      }
    ]
  }
}
