{
  "meta": {
    "$_POST": [
      {
        "name": "token",
        "type": "text",
        "fieldName": "token",
        "options": {
          "rules": {
            "core:required": {},
            "core:maxlength": {
              "param": 100
            }
          }
        }
      },
      {
        "name": "password",
        "type": "text",
        "fieldName": "password",
        "options": {
          "rules": {
            "core:required": {},
            "core:minlength": {
              "param": 12
            },
            "core:maxlength": {
              "param": 255
            }
          }
        }
      },
      {
        "name": "password_confirm",
        "type": "text",
        "fieldName": "password_confirm",
        "options": {
          "rules": {
            "core:required": {},
            "core:maxlength": {
              "param": 255
            }
          }
        }
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "passwords_match",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_POST.password == $_POST.password_confirm}}",
          "then": [
            {
              "name": "new_password_hash",
              "module": "crypto",
              "action": "passwordHash",
              "options": {
                "password": "{{$_POST.password}}",
                "algo": "argon2id"
              },
              "output": false,
              "meta": [
                {
                  "name": "new_password_hash",
                  "type": "text"
                }
              ],
              "outputType": "text"
            },
            {
              "name": "current_time",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "current_time",
                "value": "{{NOW.formatDate('yyyy-MM-dd HH:mm:ss', true)}}"
              },
              "output": false,
              "meta": [
                {
                  "name": "current_time",
                  "type": "text"
                }
              ],
              "outputType": "text"
            },
            {
              "name": "token_hash",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "token_hash",
                "value": "{{$_POST.token.sha256()}}"
              },
              "output": false,
              "meta": [
                {
                  "name": "token_hash",
                  "type": "text"
                }
              ],
              "outputType": "text"
            },
            {
              "name": "valid_recovery_token",
              "module": "dbconnector",
              "action": "select",
              "options": {
                "connection": "passport",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "citizen_password_recovery_tokens"
                  },
                  "primary": "id",
                  "columns": [
                    {
                      "table": "citizen_password_recovery_tokens",
                      "column": "id"
                    },
                    {
                      "table": "citizen_password_recovery_tokens",
                      "column": "account_id"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "citizen_password_recovery_tokens",
                        "column": "token_hash",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{token_hash}}"
                      },
                      {
                        "table": "citizen_password_recovery_tokens",
                        "column": "consumed",
                        "operator": "equal",
                        "operation": "=",
                        "value": 0
                      },
                      {
                        "table": "citizen_password_recovery_tokens",
                        "column": "expires_at",
                        "operator": "greater",
                        "operation": ">",
                        "value": "{{current_time}}"
                      }
                    ]
                  },
                  "limit": 1
                }
              },
              "output": false,
              "meta": [
                {
                  "name": "id",
                  "type": "text"
                },
                {
                  "name": "account_id",
                  "type": "text"
                }
              ],
              "outputType": "array"
            },
            {
              "name": "complete_if_token_valid",
              "module": "core",
              "action": "condition",
              "options": {
                "if": "{{valid_recovery_token.count() == 1}}",
                "then": [
                  {
                    "name": "password_recovery_transaction",
                    "module": "dbupdater",
                    "action": "transaction",
                    "options": {
                      "connection": "passport",
                      "exec": {
                        "steps": [
                          {
                            "name": "consume_recovery_token",
                            "module": "dbupdater",
                            "action": "update",
                            "options": {
                              "connection": "passport",
                              "sql": {
                                "type": "UPDATE",
                                "table": "citizen_password_recovery_tokens",
                                "values": [
                                  {
                                    "column": "consumed",
                                    "value": 1
                                  }
                                ],
                                "wheres": {
                                  "condition": "AND",
                                  "rules": [
                                    {
                                      "table": "citizen_password_recovery_tokens",
                                      "column": "id",
                                      "operator": "equal",
                                      "operation": "=",
                                      "value": "{{valid_recovery_token[0].id}}"
                                    },
                                    {
                                      "table": "citizen_password_recovery_tokens",
                                      "column": "consumed",
                                      "operator": "equal",
                                      "operation": "=",
                                      "value": 0
                                    }
                                  ]
                                }
                              }
                            },
                            "output": true,
                            "meta": [
                              {
                                "name": "affected",
                                "type": "number"
                              }
                            ],
                            "outputType": "object"
                          },
                          {
                            "name": "update_password_once",
                            "module": "core",
                            "action": "condition",
                            "options": {
                              "if": "{{consume_recovery_token.affected == 1}}",
                              "then": [
                                {
                                  "name": "update_citizen_password",
                                  "module": "dbupdater",
                                  "action": "update",
                                  "options": {
                                    "connection": "passport",
                                    "sql": {
                                      "type": "UPDATE",
                                      "table": "citizen_accounts",
                                      "values": [
                                        {
                                          "column": "password_hash",
                                          "value": "{{new_password_hash}}"
                                        }
                                      ],
                                      "wheres": {
                                        "condition": "AND",
                                        "rules": [
                                          {
                                            "table": "citizen_accounts",
                                            "column": "id",
                                            "operator": "equal",
                                            "operation": "=",
                                            "value": "{{valid_recovery_token[0].account_id}}"
                                          },
                                          {
                                            "table": "citizen_accounts",
                                            "column": "status",
                                            "operator": "equal",
                                            "operation": "=",
                                            "value": "ACTIVE"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  "output": false,
                                  "meta": [
                                    {
                                      "name": "affected",
                                      "type": "number"
                                    }
                                  ],
                                  "outputType": "object"
                                },
                                {
                                  "name": "password_reset_result",
                                  "module": "core",
                                  "action": "setvalue",
                                  "options": {
                                    "key": "passwordUpdated",
                                    "value": true
                                  },
                                  "output": true,
                                  "meta": [
                                    {
                                      "name": "passwordUpdated",
                                      "type": "boolean"
                                    }
                                  ],
                                  "outputType": "boolean"
                                }
                              ],
                              "else": [
                                {
                                  "name": "recovery_already_used",
                                  "module": "core",
                                  "action": "response",
                                  "options": {
                                    "status": 409,
                                    "data": {
                                      "message": "This recovery link has expired or was already used."
                                    }
                                  },
                                  "output": false
                                }
                              ]
                            },
                            "output": false
                          }
                        ]
                      }
                    },
                    "output": false
                  }
                ],
                "else": [
                  {
                    "name": "recovery_invalid",
                    "module": "core",
                    "action": "response",
                    "options": {
                      "status": 410,
                      "data": {
                        "message": "This recovery link has expired or was already used."
                      }
                    },
                    "output": false
                  }
                ]
              },
              "output": false
            }
          ],
          "else": [
            {
              "name": "password_mismatch",
              "module": "core",
              "action": "response",
              "options": {
                "status": 400,
                "data": {
                  "message": "The passwords do not match."
                }
              },
              "output": false
            }
          ]
        },
        "output": false
      }
    ]
  }
}
