{
  "meta": {
    "$_GET": [
      {
        "name": "token",
        "type": "text",
        "fieldName": "token",
        "options": {
          "rules": {
            "core:required": {},
            "core:maxlength": {
              "param": 100
            }
          }
        }
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "current_time",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "current_time",
          "value": "{{NOW.formatDate('yyyy-MM-dd HH:mm:ss', true)}}"
        },
        "output": false,
        "meta": [
          {
            "name": "current_time",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "token_hash",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "token_hash",
          "value": "{{$_GET.token.sha256()}}"
        },
        "output": false,
        "meta": [
          {
            "name": "token_hash",
            "type": "text"
          }
        ],
        "outputType": "text"
      },
      {
        "name": "valid_recovery_token",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "passport",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "citizen_password_recovery_tokens"
            },
            "primary": "id",
            "columns": [
              {
                "table": "citizen_password_recovery_tokens",
                "column": "id"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "citizen_password_recovery_tokens",
                  "column": "token_hash",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{token_hash}}"
                },
                {
                  "table": "citizen_password_recovery_tokens",
                  "column": "consumed",
                  "operator": "equal",
                  "operation": "=",
                  "value": 0
                },
                {
                  "table": "citizen_password_recovery_tokens",
                  "column": "expires_at",
                  "operator": "greater",
                  "operation": ">",
                  "value": "{{current_time}}"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "id",
            "type": "text"
          }
        ],
        "outputType": "array"
      },
      {
        "name": "token_valid",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "tokenValid",
          "value": "{{valid_recovery_token.count() == 1}}"
        },
        "output": true,
        "meta": [
          {
            "name": "tokenValid",
            "type": "boolean"
          }
        ],
        "outputType": "boolean"
      }
    ]
  }
}
