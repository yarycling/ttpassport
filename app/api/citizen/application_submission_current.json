{
  "meta": {
    "$_GET": [
      {
        "name": "application_key",
        "type": "text",
        "fieldName": "application_key",
        "options": {
          "rules": {
            "core:required": {}
          }
        }
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_citizen",
        "module": "auth",
        "action": "restrict",
        "options": {
          "provider": "citizen"
        },
        "output": false
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "citizen"
        },
        "output": false,
        "meta": [
          {
            "name": "identity",
            "type": "number"
          }
        ],
        "outputType": "number"
      },
      {
        "name": "owned_application",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "passport",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "passport_applications"
            },
            "primary": "id",
            "columns": [
              {
                "table": "passport_applications",
                "column": "id"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "passport_applications",
                  "column": "application_key",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{$_GET.application_key}}"
                },
                {
                  "table": "passport_applications",
                  "column": "account_id",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{identity}}"
                },
                {
                  "table": "passport_applications",
                  "column": "application_type",
                  "operator": "equal",
                  "operation": "=",
                  "value": "FIRST_TIME"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "id",
            "type": "text"
          }
        ],
        "outputType": "array"
      },
      {
        "name": "load_submission_if_owned",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{owned_application.count() == 1}}",
          "then": [
            {
              "name": "submission",
              "module": "dbconnector",
              "action": "select",
              "options": {
                "connection": "passport",
                "sql": {
                  "type": "SELECT",
                  "table": {
                    "name": "passport_application_demo_submissions"
                  },
                  "primary": "id",
                  "columns": [
                    {
                      "table": "passport_application_demo_submissions",
                      "column": "internal_demo_reference"
                    },
                    {
                      "table": "passport_application_demo_submissions",
                      "column": "snapshot_version"
                    },
                    {
                      "table": "passport_application_demo_submissions",
                      "column": "submission_status"
                    },
                    {
                      "table": "passport_application_demo_submissions",
                      "column": "submitted_at"
                    },
                    {
                      "table": "passport_application_demo_submissions",
                      "column": "ivp_application_ref"
                    }
                  ],
                  "wheres": {
                    "condition": "AND",
                    "rules": [
                      {
                        "table": "passport_application_demo_submissions",
                        "column": "application_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{owned_application[0].id}}"
                      },
                      {
                        "table": "passport_application_demo_submissions",
                        "column": "account_id",
                        "operator": "equal",
                        "operation": "=",
                        "value": "{{identity}}"
                      }
                    ]
                  },
                  "limit": 1
                }
              },
              "output": true,
              "meta": [
                {
                  "name": "internal_demo_reference",
                  "type": "text"
                },
                {
                  "name": "snapshot_version",
                  "type": "number"
                },
                {
                  "name": "submission_status",
                  "type": "text"
                },
                {
                  "name": "submitted_at",
                  "type": "datetime"
                },
                {
                  "name": "ivp_application_ref",
                  "type": "text"
                }
              ],
              "outputType": "array"
            }
          ],
          "else": [
            {
              "name": "application_not_found",
              "module": "core",
              "action": "response",
              "options": {
                "status": 404,
                "data": {
                  "message": "The saved application was not found."
                }
              },
              "output": false
            }
          ]
        },
        "output": false
      }
    ]
  }
}
