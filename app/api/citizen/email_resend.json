{
  "meta": {
    "$_POST": [
      {
        "name": "email",
        "type": "text",
        "fieldName": "email",
        "options": {
          "rules": {
            "core:required": {},
            "core:email": {},
            "core:maxlength": {
              "param": 254
            }
          }
        }
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "unverified_account",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "passport",
          "sql": {
            "type": "SELECT",
            "table": {
              "name": "citizen_accounts"
            },
            "primary": "id",
            "columns": [
              {
                "table": "citizen_accounts",
                "column": "id"
              },
              {
                "table": "citizen_accounts",
                "column": "email"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "table": "citizen_accounts",
                  "column": "email",
                  "operator": "equal",
                  "operation": "=",
                  "value": "{{$_POST.email}}"
                },
                {
                  "table": "citizen_accounts",
                  "column": "email_verified",
                  "operator": "equal",
                  "operation": "=",
                  "value": 0
                },
                {
                  "table": "citizen_accounts",
                  "column": "status",
                  "operator": "equal",
                  "operation": "=",
                  "value": "ACTIVE"
                }
              ]
            },
            "limit": 1
          }
        },
        "output": false,
        "meta": [
          {
            "name": "id",
            "type": "text"
          },
          {
            "name": "email",
            "type": "text"
          }
        ],
        "outputType": "array"
      },
      {
        "name": "issue_verification_if_needed",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{unverified_account.count() == 1}}",
          "then": [
            {
              "name": "email_token",
              "module": "crypto",
              "action": "uuid",
              "options": {},
              "output": false,
              "meta": [
                {
                  "name": "email_token",
                  "type": "text"
                }
              ],
              "outputType": "text"
            },
            {
              "name": "email_token_hash",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "emailTokenHash",
                "value": "{{email_token.sha256()}}"
              },
              "output": false,
              "meta": [
                {
                  "name": "emailTokenHash",
                  "type": "text"
                }
              ],
              "outputType": "text"
            },
            {
              "name": "email_token_expiry",
              "module": "core",
              "action": "setvalue",
              "options": {
                "key": "emailTokenExpiry",
                "value": "{{NOW.dateAdd('hours', 24).formatDate('yyyy-MM-dd HH:mm:ss', true)}}"
              },
              "output": false,
              "meta": [
                {
                  "name": "emailTokenExpiry",
                  "type": "text"
                }
              ],
              "outputType": "text"
            },
            {
              "name": "resend_token_transaction",
              "module": "dbupdater",
              "action": "transaction",
              "options": {
                "connection": "passport",
                "exec": {
                  "steps": [
                    {
                      "name": "invalidate_previous_email_tokens",
                      "module": "dbupdater",
                      "action": "update",
                      "options": {
                        "connection": "passport",
                        "sql": {
                          "type": "UPDATE",
                          "table": "citizen_email_verification_tokens",
                          "values": [
                            {
                              "column": "consumed",
                              "value": 1
                            }
                          ],
                          "wheres": {
                            "condition": "AND",
                            "rules": [
                              {
                                "table": "citizen_email_verification_tokens",
                                "column": "account_id",
                                "operator": "equal",
                                "operation": "=",
                                "value": "{{unverified_account[0].id}}"
                              },
                              {
                                "table": "citizen_email_verification_tokens",
                                "column": "consumed",
                                "operator": "equal",
                                "operation": "=",
                                "value": 0
                              }
                            ]
                          }
                        }
                      },
                      "output": false,
                      "meta": [
                        {
                          "name": "affected",
                          "type": "number"
                        }
                      ],
                      "outputType": "object"
                    },
                    {
                      "name": "create_email_token",
                      "module": "dbupdater",
                      "action": "insert",
                      "options": {
                        "connection": "passport",
                        "sql": {
                          "type": "INSERT",
                          "table": "citizen_email_verification_tokens",
                          "values": [
                            {
                              "column": "account_id",
                              "value": "{{unverified_account[0].id}}"
                            },
                            {
                              "column": "token_hash",
                              "value": "{{emailTokenHash}}"
                            },
                            {
                              "column": "expires_at",
                              "value": "{{emailTokenExpiry}}"
                            },
                            {
                              "column": "consumed",
                              "value": 0
                            }
                          ]
                        }
                      },
                      "output": false,
                      "meta": [
                        {
                          "name": "identity",
                          "type": "number"
                        },
                        {
                          "name": "affected",
                          "type": "number"
                        }
                      ],
                      "outputType": "object"
                    }
                  ]
                }
              },
              "output": false
            },
            {
              "name": "try_send_verification",
              "module": "core",
              "action": "trycatch",
              "options": {
                "try": [
                  {
                    "name": "send_verification",
                    "module": "mail",
                    "action": "send",
                    "options": {
                      "instance": "localDevelopment",
                      "fromEmail": "citizen-accounts@ttpassport.local",
                      "fromName": "TTPASSPORT Development",
                      "toEmail": "{{unverified_account[0].email}}",
                      "subject": "Verify your TTPASSPORT development account",
                      "source": "static",
                      "contentType": "html",
                      "body": "<p>This is a local TTPASSPORT Development email.</p><p><a href=\"http://127.0.0.1:3002/account/verify-email?token={{email_token}}\">Verify this email address</a></p><p>The link expires in 24 hours. If you did not request this message, you can ignore it.</p>"
                    },
                    "output": false
                  }
                ],
                "catch": []
              },
              "output": false
            }
          ],
          "else": []
        },
        "output": false
      },
      {
        "name": "resend_result",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "message",
          "value": "If that address has an account awaiting verification, a new message has been sent."
        },
        "output": true,
        "meta": [
          {
            "name": "message",
            "type": "text"
          }
        ],
        "outputType": "text"
      }
    ]
  }
}
