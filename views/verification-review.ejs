<!-- Wappler include head-page="layouts/main" bootstrap5="local" is="dmx-app" id="verificationReview" appConnect="local" -->
<section class="page-section" aria-labelledby="verification-review-heading">
  <div class="container-fluid page-container">
    <div class="page-title-row">
      <div>
        <p class="section-kicker">Identity verification · Visual preview</p>
        <h1 id="verification-review-heading">Verification review status</h1>
        <p class="page-subtitle">A neutral status layout for future evidence review. No identity session or assertion exists.</p>
      </div>
      <span class="status-chip status-chip--neutral">Not started</span>
    </div>
    <div class="notice-alert notice-alert--warning mb-4" role="note">
      <strong>No identity check has run</strong>
      This preview does not claim a person is verified and does not perform biometric or registry checks.
    </div>
    <div class="row g-3">
      <div class="col-lg-7">
        <section class="content-panel" aria-labelledby="checklist-heading">
          <h2 id="checklist-heading">Review checklist</h2>
          <ul class="step-bullet-list mb-0">
            <li><span class="step-bullet" aria-hidden="true">1</span><span><strong>Document validity</strong><br><span class="field-help">Not assessed · source unavailable</span></span></li>
            <li><span class="step-bullet" aria-hidden="true">2</span><span><strong>Person-to-evidence review</strong><br><span class="field-help">Not assessed · no evidence uploaded</span></span></li>
            <li><span class="step-bullet" aria-hidden="true">3</span><span><strong>Citizenship eligibility</strong><br><span class="field-help">Separate future policy check · not assessed</span></span></li>
          </ul>
        </section>
      </div>
      <aside class="col-lg-5">
        <div class="content-panel h-100">
          <h2>Review status</h2>
          <p><span class="status-chip status-chip--neutral">Not assessed</span></p>
          <p>Any future result must identify the evidence, source and policy checks actually completed.</p>
          <div class="notice-alert"><strong>Retry and help</strong>If a future capture is interrupted, use the documented support route. This preview cannot restart a session.</div>
        </div>
      </aside>
    </div>
    <div class="mt-4"><a class="btn btn-outline-crimson" href="/verification/preview">Return to capture guidance</a></div>
  </div>
</section>
