<!-- Wappler include head-page="layouts/main" bootstrap5="local" is="dmx-app" id="verificationCapture" appConnect="local" -->
<section class="page-section" aria-labelledby="verification-heading">
  <div class="container-fluid page-container">
    <div class="verification-hero mb-4">
      <p class="section-kicker">Identity verification · Visual preview</p>
      <h1 id="verification-heading">Identity evidence steps</h1>
      <p class="page-subtitle">A reusable interface concept for future document and photo capture. No capture, comparison or authoritative source checks are active.</p>
    </div>
    <div class="notice-alert notice-alert--warning mb-4" role="note">
      <strong>Do not upload real identity evidence</strong>
      This page has no private storage, camera, document review or identity verification service.
    </div>
    <div class="verification-steps mb-4">
      <article class="verification-step"><span class="status-chip status-chip--neutral">Not connected</span><h2 class="mt-3">1. Prepare</h2><p class="mb-0">Approved document guidance will be supplied separately.</p></article>
      <article class="verification-step"><span class="status-chip status-chip--neutral">Not connected</span><h2 class="mt-3">2. Capture evidence</h2><p class="mb-0">Camera and secure document upload are not available.</p></article>
      <article class="verification-step"><span class="status-chip status-chip--neutral">Not connected</span><h2 class="mt-3">3. Review status</h2><p class="mb-0">No comparison, liveness or registry check is performed.</p></article>
    </div>
    <div class="row g-3">
      <div class="col-lg-7">
        <section class="content-panel" aria-labelledby="capture-heading">
          <h2 id="capture-heading">Document and photo capture</h2>
          <div class="capture-guide mb-3">
            <div><div class="capture-guide-shape" aria-hidden="true">Position guide</div><p>Placeholder only. No face image or camera preview is shown.</p></div>
          </div>
          <label class="form-label" for="verification-document">Document upload</label>
          <input class="form-control" id="verification-document" type="file" disabled aria-describedby="verification-upload-note">
          <p id="verification-upload-note" class="field-help mt-2">Upload is disabled. Do not select or submit a real document.</p>
        </section>
      </div>
      <aside class="col-lg-5">
        <div class="content-panel h-100">
          <h2>Capture guidance</h2>
          <ul class="guidance-list">
            <li>Use clear, even lighting for any future capture flow.</li>
            <li>Keep the original evidence separate from any passport-print photograph.</li>
            <li>Use the accessible retry and support path if a future capture is interrupted.</li>
          </ul>
          <div class="notice-alert mt-3"><strong>Camera state</strong>No camera permission is requested by this preview.</div>
        </div>
      </aside>
    </div>
    <div class="d-flex flex-wrap justify-content-between gap-2 mt-4">
      <a class="btn btn-outline-crimson" href="/">Return to citizen preview</a>
      <a class="btn btn-primary-government" href="/verification/preview/review">View review status layout</a>
    </div>
  </div>
</section>
