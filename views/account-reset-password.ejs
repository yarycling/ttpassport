<!-- Wappler include head-page="layouts/main" bootstrap5="local" is="dmx-app" id="resetPassword" appConnect="local" -->
<section class="auth-page" aria-labelledby="reset-heading">
  <div class="container-fluid page-container">
    <div class="auth-card">
      <p class="section-kicker">Citizen account</p>
      <h1 id="reset-heading">Set a new password</h1>
      <div class="notice-alert notice-alert--warning mb-4" role="note">
        <strong>Password reset preview only</strong>
        Reset tokens and password updates are not implemented. Do not enter a password.
      </div>
      <form aria-describedby="reset-preview-note">
        <div class="mb-3">
          <label class="form-label" for="reset-password">New password</label>
          <input class="form-control" id="reset-password" type="password" placeholder="New password" disabled aria-describedby="reset-preview-note">
        </div>
        <div class="mb-3">
          <label class="form-label" for="reset-confirm">Confirm new password</label>
          <input class="form-control" id="reset-confirm" type="password" placeholder="Confirm new password" disabled aria-describedby="reset-preview-note">
        </div>
        <button class="btn btn-primary-government" type="button" disabled>Password update unavailable</button>
        <p class="field-help mt-3 mb-0" id="reset-preview-note">The form is disabled and does not submit data.</p>
      </form>
    </div>
  </div>
</section>
