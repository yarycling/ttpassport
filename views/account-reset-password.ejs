<!-- Wappler include head-page="layouts/main" bootstrap5="local" is="dmx-app" id="resetPassword" appConnect="local" -->
<dmx-value id="passwordResetComplete" dmx-bind:value="false"></dmx-value>
<dmx-serverconnect id="passwordRecoveryToken" url="/api/citizen/password_recovery_validate" dmx-param:token="query.token" noload="true"></dmx-serverconnect>
<section class="auth-page" aria-labelledby="reset-heading">
  <div class="container-fluid page-container">
    <div class="auth-card">
      <p class="section-kicker">Citizen account</p>
      <h1 id="reset-heading">Set a new password</h1>
      <div class="notice-alert notice-alert--warning mb-4" role="note">
        <strong>Local Development only</strong>
        Reset links are single-use and expire after one hour. Production email delivery is not configured.
      </div>
      <form id="citizenPasswordResetForm" is="dmx-serverconnect-form" method="post" action="/api/citizen/password_recovery_complete" dmx-on:success="passwordResetComplete.setValue(true)" aria-describedby="reset-preview-note" dmx-show="query.token">
        <input type="hidden" name="token" dmx-bind:value="query.token">
        <div class="mb-3">
          <label class="form-label" for="reset-password">New password</label>
          <input class="form-control" id="reset-password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="255" aria-describedby="reset-preview-note">
        </div>
        <div class="mb-3">
          <label class="form-label" for="reset-confirm">Confirm new password</label>
          <input class="form-control" id="reset-confirm" name="password_confirm" type="password" autocomplete="new-password" required minlength="12" maxlength="255" aria-describedby="reset-preview-note">
        </div>
        <div class="notice-alert" role="status" dmx-show="passwordResetComplete.value">Password updated. Sign in with the new password.</div>
        <div class="notice-alert notice-alert--warning" role="alert" dmx-show="citizenPasswordResetForm.lastError.status">The passwords must match, and the recovery link must be current and unused.</div>
        <button class="btn btn-primary-government" type="submit" dmx-bind:disabled="citizenPasswordResetForm.state.executing || passwordResetComplete.value">Update password</button>
        <p class="field-help mt-3 mb-0" id="reset-preview-note">Use at least 12 characters. This changes the account password only and does not verify identity or citizenship.</p>
      </form>
      <div class="notice-alert notice-alert--warning" role="note" dmx-show="!query.token">Open the password reset link from the local Development email.</div>
      <a class="d-inline-block mt-4" href="/account/sign-in">Return to sign in</a>
    </div>
  </div>
</section>
