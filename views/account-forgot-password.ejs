<!-- Wappler include head-page="layouts/main" bootstrap5="local" is="dmx-app" id="forgotPassword" appConnect="local" -->
<dmx-value id="recoveryMessageSent" dmx-bind:value="false"></dmx-value>
<section class="auth-page" aria-labelledby="forgot-heading">
  <div class="container-fluid page-container">
    <div class="auth-card">
      <p class="section-kicker">Citizen account</p>
      <h1 id="forgot-heading">Forgot your password?</h1>
      <div class="notice-alert notice-alert--warning mb-4" role="note">
        <strong>Local Development only</strong>
        Recovery messages are captured by the local MailHog service. Production email delivery is not configured.
      </div>
      <form id="citizenRecoveryRequestForm" is="dmx-serverconnect-form" method="post" action="/api/citizen/password_recovery_request" dmx-on:success="recoveryMessageSent.setValue(true)" aria-describedby="forgot-preview-note">
        <div class="mb-3">
          <label class="form-label" for="forgot-email">Email address</label>
          <input class="form-control" id="forgot-email" name="email" type="email" autocomplete="email" placeholder="Email address" required maxlength="254" aria-describedby="forgot-preview-note">
        </div>
        <div class="notice-alert" role="status" dmx-show="recoveryMessageSent.value">If a verified account matches that address, a recovery message has been sent.</div>
        <div class="notice-alert notice-alert--warning" role="alert" dmx-show="citizenRecoveryRequestForm.lastError.status">The request could not be completed. Try again shortly.</div>
        <button class="btn btn-primary-government" type="submit" dmx-bind:disabled="citizenRecoveryRequestForm.state.executing">Send recovery email</button>
        <p class="field-help mt-3 mb-0" id="forgot-preview-note">Links expire after one hour and can be used once. Account recovery does not change email verification status.</p>
      </form>
      <a class="d-inline-block mt-4" href="/account/sign-in">Return to sign in</a>
    </div>
  </div>
</section>
