<!-- Wappler include head-page="layouts/main" bootstrap5="local" is="dmx-app" id="forgotPassword" appConnect="local" -->
<section class="auth-page" aria-labelledby="forgot-heading">
  <div class="container-fluid page-container">
    <div class="auth-card">
      <p class="section-kicker">Citizen account</p>
      <h1 id="forgot-heading">Forgot your password?</h1>
      <div class="notice-alert notice-alert--warning mb-4" role="note">
        <strong>Recovery is not connected</strong>
        This preview does not accept email addresses or send reset links.
      </div>
      <form aria-describedby="forgot-preview-note">
        <div class="mb-3">
          <label class="form-label" for="forgot-email">Email address</label>
          <input class="form-control" id="forgot-email" type="email" placeholder="Email address" disabled aria-describedby="forgot-preview-note">
        </div>
        <button class="btn btn-primary-government" type="button" disabled>Password reset unavailable</button>
        <p class="field-help mt-3 mb-0" id="forgot-preview-note">No recovery or account enumeration behavior is implemented.</p>
      </form>
      <a class="d-inline-block mt-4" href="/account/sign-in">Return to sign in</a>
    </div>
  </div>
</section>
