<!-- Wappler include head-page="layouts/main" bootstrap5="local" is="dmx-app" id="citizenDashboard" appConnect="local" -->
<section class="page-section dashboard-backdrop" aria-labelledby="dashboard-heading">
  <div class="container-fluid page-container">
    <div class="page-title-row">
      <div>
        <p class="section-kicker">Citizen portal preview</p>
        <h1 id="dashboard-heading">Your passport dashboard</h1>
        <p class="page-subtitle">A visual shell for future application tasks. No account or application data is connected.</p>
      </div>
      <a class="btn btn-primary-government" href="/citizen/apply/first-time">Start application preview</a>
    </div>
    <div class="notice-alert notice-alert--warning mb-4" role="note">
      <strong>No live account is connected</strong>
      Application cards, status counts and correction requests will appear only after approved services are implemented.
    </div>
    <div class="row g-3 mb-4">
      <div class="col-md-4"><div class="stat-card"><span class="stat-value">—</span><span class="stat-label">Applications</span></div></div>
      <div class="col-md-4"><div class="stat-card"><span class="stat-value">—</span><span class="stat-label">Drafts</span></div></div>
      <div class="col-md-4"><div class="stat-card"><span class="stat-value">—</span><span class="stat-label">Actions needed</span></div></div>
    </div>
    <div class="content-panel">
      <div class="section-heading"><h2>Applications</h2></div>
      <div class="empty-state">
        <span class="empty-mark" aria-hidden="true">—</span>
        <h3>No application data is available</h3>
        <p class="mb-3">This is a design preview with no connected application source.</p>
        <a class="btn btn-outline-crimson" href="/citizen/track">View tracking preview</a>
      </div>
    </div>
  </div>
</section>
